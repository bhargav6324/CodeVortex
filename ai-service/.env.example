# Copy to .env and fill in. Never commit .env.

# Backend -> AI bearer credential (must match the backend's AI_SERVICE_TOKEN)
AI_SERVICE_TOKEN=change-me

# AI -> backend tool gateway
BACKEND_TOOL_BASE_URL=http://100.83.115.82:8000
BACKEND_TOOL_TOKEN=change-me

# Gemini: select an available model at setup and record its actual version in the README
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Per-turn telemetry (IDs, outcome, codes, timing only; no message text or secrets)
TELEMETRY_PATH=logs/turns.jsonl
