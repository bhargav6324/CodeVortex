AI_SERVICE_BASE_URL=http://100.114.163.7:8001
CORS_ORIGINS=http://100.117.73.55:5173,http://localhost:5173
DELIVERY_MODE=mock_email
# Storage paths are relative to the backend folder unless absolute.
# Preserve memory while the tester checks the existing server.
# For the persistent review workflow, switch to sqlite at a coordinated restart.
STORAGE_BACKEND=memory
DATABASE_PATH=data/codevortex.sqlite3
# DATASET_PATH=fixtures/dataset.json
# DRAFT_FIXTURE_PATH=fixtures/drafts.json
# Setting DATASET_PATH to another file disables draft fixtures by default.
# DRAFT_FIXTURE_PATH=  explicitly loads no sample drafts.
# Per-reviewer limits per minute (contract demo defaults). 429 RATE_LIMITED includes Retry-After.
RATE_LIMIT_GENERATE_PER_MINUTE=20
RATE_LIMIT_READ_REVIEW_PER_MINUTE=60
# Demo retention for scripts/cleanup_database.py; minimum 7.
RETENTION_DAYS=7
AI_SERVICE_TOKEN=<random-secret-at-least-32-characters>
BACKEND_TOOL_TOKEN=<different-random-secret-at-least-32-characters>
DELEGATION_SIGNING_SECRET=<backend-only-random-signing-secret>
# JSON string with provisioned reviewer scopes. Never expose this file in the frontend.
# scripts/create_local_env.py generates real random tokens and a 24-hour expiry.
REVIEWERS_JSON='[{"token":"<random-reviewer-token-at-least-32-characters>","actor_id":"REVIEWER001","role":"reviewer","customer_ids":["CUST001","CUST002","CUST003","CUST004","CUST005"],"expires_at":"2026-11-01T06:00:00Z"}]'
