# Frontend public configuration. Copy to .env and adjust.
# Never put reviewer tokens, Gemini keys or any other secret here:
# every VITE_ variable is bundled into the browser code.

# FastAPI backend (shared contract v1.0.0)
VITE_API_BASE_URL=http://100.83.115.82:8000

# true  = use the in-browser MSW mock backend (no real backend needed)
# false = call the real backend at VITE_API_BASE_URL
VITE_USE_MOCKS=true
