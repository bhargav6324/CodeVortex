            "code",
            "message",
            "request_id",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAUTHORIZED",
                "FORBIDDEN",
                "NOT_FOUND",
                "INVALID_REQUEST",
                "IDEMPOTENCY_CONFLICT",
                "VERSION_CONFLICT",
                "REVIEW_BLOCKED",
